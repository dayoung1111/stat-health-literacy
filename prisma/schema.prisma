generator client {
  provider = "prisma-client"
  output   = "../src/generated_prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

/// 의료진이 발급한 교육 코드. 고른 안내 여러 개를 코드 1개·QR 1개·링크 1개로 묶는다.
/// 환자 이름·등록번호·전화번호는 저장하지 않는다.
model EducationCode {
  id                   String    @id @default(uuid()) @db.Uuid
  /// 환자에게 주는 6자리 숫자. 만료된 코드는 지운 뒤 다시 쓸 수 있다.
  code                 String    @unique @db.VarChar(6)
  /// 발급한 간호사 아이디(지금은 시연용 nurse01). 이 간호사만 조회할 수 있게 서버에서 확인한다.
  staffId              String    @map("staff_id")
  /// 묶어 보낸 안내: checkup / colonoscopy / gastroscopy / medication
  guides               String[]
  /// 맞춤 설정. 나이대: 10-40 / 50 / 60 / 70. 복용약 안내에는 언어·큰 글씨만 적용한다.
  ageGroup             String    @map("age_group")
  /// 설명 단계: normal / easy / very-easy
  level                String
  language             String
  /// 추가 도움: large-text / guardian / developmental
  extras               String[]
  /// 검사일. 시각 없는 날짜이며 한국 날짜 기준이다.
  examDate             DateTime  @map("exam_date") @db.Date
  /// 피를 묽게 하는 약 중단 시작일(선택). 시각 없는 날짜이며 한국 날짜 기준이다.
  /// 비우면 환자 화면에 "의사 선생님과 정한 날짜부터"로 보인다.
  bloodThinnerStopDate DateTime? @map("blood_thinner_stop_date") @db.Date
  /// 생년월일 6자리를 되돌릴 수 없게 암호화한 값(scrypt, 코드마다 다른 소금 포함)
  birthDateHash        String    @map("birth_date_hash")
  /// 생년월일을 틀린 횟수. 5번이 되면 lockedAt을 기록하고 더는 들어올 수 없다.
  failedAttempts       Int       @default(0) @map("failed_attempts")
  lockedAt             DateTime? @map("locked_at") @db.Timestamptz
  /// 발급 7일 뒤(UTC로 저장). 지나면 화면에서 숨기고, 묶인 기록과 함께 지운다.
  expiresAt            DateTime  @map("expires_at") @db.Timestamptz
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz

  medicationCheck  MedicationCheck?
  teachbackResults TeachbackResult[]
  confusionMarks   ConfusionMark[]
  guideCompletions GuideCompletion[]

  @@index([staffId, expiresAt])
  @@map("education_codes")
}

/// 환자가 체크한 "내가 먹는 약". 코드마다 하나이며, 다시 체크하면 최신으로 바꾼다.
model MedicationCheck {
  codeId      String        @id @map("code_id") @db.Uuid
  /// 코드가 지워지면 함께 지워진다.
  code        EducationCode @relation(fields: [codeId], references: [id], onDelete: Cascade)
  /// blood-pressure(혈압약) / diabetes(당뇨약) / insulin(인슐린) / blood-thinner(피를 묽게 하는 약) / supplement(영양제·한약) / other(기타 약)
  medications String[]
  checkedAt   DateTime      @map("checked_at") @db.Timestamptz
  /// 약마다 처음 고른 시각(UTC). {"blood-pressure": "2026-10-29T09:59:00Z"} 모양이다.
  /// 약을 더하거나 빼도 이미 고른 약의 시각은 그대로 둔다. 뺀 약의 확인 질문 결과는 TeachbackResult에 남는다.
  pickedAt    Json          @map("picked_at")

  @@map("medication_checks")
}

/// 티치백 결과. 같은 안내의 같은 질문을 다시 풀면 최신 결과로 바꾼다.
model TeachbackResult {
  id         String           @id @default(uuid()) @db.Uuid
  codeId     String           @map("code_id") @db.Uuid
  /// 코드가 지워지면 함께 지워진다.
  code       EducationCode    @relation(fields: [codeId], references: [id], onDelete: Cascade)
  /// 어느 안내의 질문인지(예: colonoscopy)
  guide      String
  /// 질문 주제(예: 첫 번째 약 시간)
  question   String
  result     TeachbackOutcome
  answeredAt DateTime         @map("answered_at") @db.Timestamptz

  @@unique([codeId, guide, question])
  @@map("teachback_results")
}

/// "헷갈려요"를 누른 곳. 같은 문단을 다시 누르면 횟수를 늘리고 마지막 시각을 바꾼다.
model ConfusionMark {
  id          String        @id @default(uuid()) @db.Uuid
  codeId      String        @map("code_id") @db.Uuid
  /// 코드가 지워지면 함께 지워진다.
  code        EducationCode @relation(fields: [codeId], references: [id], onDelete: Cascade)
  /// 어느 안내인지(예: colonoscopy)
  guide       String
  /// 안내 안의 문단 아이디(예: prep-first)
  paragraphId String        @map("paragraph_id")
  /// 누른 횟수(1부터)
  count       Int           @default(1)
  lastAt      DateTime      @map("last_at") @db.Timestamptz

  @@unique([codeId, guide, paragraphId])
  @@map("confusion_marks")
}

/// 환자가 끝까지 마친 안내(대장내시경: 8교시 끝, 드시는 약: "확인했어요"). 안내마다 한 번만 남기며, 다시 마쳐도 처음 시각을 그대로 둔다.
model GuideCompletion {
  id          String        @id @default(uuid()) @db.Uuid
  codeId      String        @map("code_id") @db.Uuid
  /// 코드가 지워지면 함께 지워진다.
  code        EducationCode @relation(fields: [codeId], references: [id], onDelete: Cascade)
  /// 마친 안내(checkup / colonoscopy / gastroscopy / medication)
  guide       String
  completedAt DateTime      @map("completed_at") @db.Timestamptz

  @@unique([codeId, guide])
  @@map("guide_completions")
}

/// 환자 화면에서 난 오류 기록. 30일이 지나면 지운다(src/lib/error-log-store.ts, Supabase 예약 작업).
/// 생년월일·이름·환자가 입력한 값·오류 문장은 저장하지 않는다. 접근 규칙(RLS)으로 Supabase 공개 API에서는 읽을 수 없다.
/// 코드가 만료돼 지워져도 기록은 남도록 EducationCode와 관계를 걸지 않는다.
model ErrorLog {
  id          String    @id @default(uuid()) @db.Uuid
  /// 환자 화면에 크게 보여 준 번호(예: E-4821). 환자가 간호사에게 알려 준다.
  errorNumber String    @map("error_number") @db.VarChar(6)
  /// 교육 코드(6자리 또는 DEMO). 확인할 수 없는 코드는 비운다.
  code        String?   @db.VarChar(6)
  /// 그 코드를 발급한 간호사 아이디. 간호사는 이 값이 자기인 기록만 본다.
  staffId     String?   @map("staff_id")
  /// 화면 위치(예: 대장내시경 수업 5교시 3단계 / 복용약 체크). 정해진 이름만 저장한다.
  place       String    @db.VarChar(60)
  /// photo-load / no-response / code-expired / birth-locked / other
  kind        String
  /// 휴대폰 / 태블릿 / PC
  device      String
  /// 브라우저 이름(예: 삼성 인터넷). 전체 브라우저 정보는 저장하지 않는다.
  browser     String
  /// 서버 오류일 때 Vercel 기록과 맞춰 볼 수 있는 짧은 번호(오류 문장 아님)
  digest      String?   @db.VarChar(64)
  resolvedAt  DateTime? @map("resolved_at") @db.Timestamptz
  /// "해결함"을 누른 의료진 아이디
  resolvedBy  String?   @map("resolved_by")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([createdAt])
  @@index([staffId, createdAt])
  @@index([code])
  @@index([errorNumber])
  @@map("error_logs")
}

/// 관리자가 만든 간호사 계정. 시연 계정(nurse01·nurse02·admin01)은 코드(demo-staff.ts)에 있고 이 표에 없다.
/// 비밀번호는 글자 그대로 저장하지 않고 scrypt 해시("소금:해시")만 저장한다.
/// 접근 규칙(RLS)으로 Supabase 공개 API에서는 읽을 수 없고, 앱 서버만 읽고 쓴다.
model StaffAccount {
  /// 로그인 아이디(영문·숫자·_·-, 3~32자). 로그인 때 소문자로 맞추지 않으므로 그대로 비교한다.
  id           String   @id
  name         String
  passwordHash String   @map("password_hash")
  /// 지금은 nurse만 만든다. 관리자 계정은 이 화면에서 만들지 않는다.
  role         String   @default("nurse")
  /// false면 로그인할 수 없고, 이미 로그인한 상태도 다음 요청부터 끝난다. 발급한 코드는 그대로 남는다.
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("staff_accounts")
}

/// 티치백 결과: 처음에 맞힘 / 다시 설명 후 맞힘 / 틀림
enum TeachbackOutcome {
  correct
  retry_correct
  wrong
}
